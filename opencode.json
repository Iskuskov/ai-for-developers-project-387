{
  "$schema": "https://opencode.ai/config.json",
  "share": "manual",
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "deny" }
  ],
  "mcp": {
    "render": {
      "type": "remote",
      "url": "https://mcp.render.com/mcp",
      "enabled": true
    }
  }
}
